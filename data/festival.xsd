<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified"
           xmlns:xs="http://www.w3.org/2001/XMLSchema">
    
    <!-- ===================== CUSTOM SIMPLE TYPES with restrictions ===================== -->
    
    <!-- Time in HH:MM format (24h) -->
    <xs:simpleType name="TimeType">
        <xs:restriction base="xs:string">
            <!-- Pattern enforces valid time like 14:30, 23:59 -->
            <xs:pattern value="([01]?[0-9]|2[0-3]):[0-5][0-9]"/>
        </xs:restriction>
    </xs:simpleType>
    
    <!-- Role - enumeration -->
    <xs:simpleType name="RoleType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="DJ"/>
            <xs:enumeration value="Live Act"/>
        </xs:restriction>
    </xs:simpleType>
    
    <!-- Genre - controlled vocabulary -->
    <xs:simpleType name="GenreType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="EDM"/>
            <xs:enumeration value="House"/>
            <xs:enumeration value="Techno"/>
            <xs:enumeration value="Trance"/>
            <xs:enumeration value="Drum &amp; Bass"/>
            <xs:enumeration value="Hardstyle"/>
            <xs:enumeration value="Progressive House"/>
            <xs:enumeration value="Electronic"/>
        </xs:restriction>
    </xs:simpleType>
    
    <!-- Capacity: realistic range for festival stages -->
    <xs:simpleType name="CapacityType">
        <xs:restriction base="xs:positiveInteger">
            <xs:minInclusive value="1000"/>
            <xs:maxInclusive value="50000"/>
        </xs:restriction>
    </xs:simpleType>
    
    <!-- ===================== MAIN STRUCTURE ===================== -->
    
    <xs:element name="festival">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="identity">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="name"          type="xs:string"/>
                            <xs:element name="edition"       type="xs:unsignedByte"/>
                            <xs:element name="location">     <!-- unchanged --></xs:element>
                            <xs:element name="dates">        <!-- unchanged --></xs:element>
                            <xs:element name="theme"         type="xs:string"/>
                            <xs:element name="genres">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="genre" type="GenreType" maxOccurs="unbounded"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <!-- Added for GET /api/festival endpoint -->
                            <xs:element name="description" type="xs:string"/>
                            <xs:element name="tickets">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="standard"   type="xs:string"/>
                                        <xs:element name="vip"        type="xs:string"/>
                                        <xs:element name="earlyBird"  type="xs:string" minOccurs="0"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="links" minOccurs="0">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="link" type="xs:anyURI" maxOccurs="unbounded"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                
                <xs:element name="venues">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="venue" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="name"       type="xs:string"/>
                                        <xs:element name="type"       type="xs:string"/>
                                        <xs:element name="capacity"   type="CapacityType"/> <!-- restricted -->
                                        <xs:element name="area"       type="xs:string"/>
                                        <xs:element name="address">   <!-- unchanged --></xs:element>
                                        <xs:element name="facilities"><!-- unchanged --></xs:element>
                                    </xs:sequence>
                                    <xs:attribute name="id" type="xs:ID" use="required"/> <!-- now ID -->
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                
                <xs:element name="performers">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="performer" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="name"    type="xs:string"/>
                                        <xs:element name="role"    type="RoleType"/>        <!-- enum -->
                                        <xs:element name="country" type="xs:string"/>
                                        <xs:element name="tags">   <!-- unchanged --></xs:element>
                                    </xs:sequence>
                                    <xs:attribute name="id" type="xs:ID" use="required"/> <!-- now ID -->
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                
                <xs:element name="programme">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="event" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="start"      type="TimeType"/>     <!-- pattern -->
                                        <xs:element name="end"        type="TimeType"/>     <!-- pattern -->
                                        <xs:element name="type"       type="xs:string"/>
                                        <xs:element name="title"      type="xs:string"/>
                                        <xs:element name="performers">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="performerRef" maxOccurs="unbounded">
                                                        <xs:complexType>
                                                            <xs:attribute name="ref" type="xs:IDREF" use="required"/> <!-- now IDREF -->
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                    <xs:attribute name="id"       type="xs:ID" use="required"/>
                                    <xs:attribute name="date"     type="xs:date" use="required"/>
                                    <xs:attribute name="venueRef" type="xs:IDREF" use="required"/> <!-- now IDREF -->
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            
            <xs:attribute name="id"   type="xs:string" use="required"/>
            <xs:attribute name="year" type="xs:unsignedShort" use="required"/>
        </xs:complexType>
    </xs:element>
</xs:schema>